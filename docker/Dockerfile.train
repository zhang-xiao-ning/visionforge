FROM python:3.12-slim

# Use Tsinghua mirror to speed up non-torch installs (China network)
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /app

# GPU torch (CUDA 12.1) from the official PyTorch index
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cu121 \
    torch==2.2.2 torchvision==0.17.2

# Training-time dependencies
RUN pip install --no-cache-dir \
    tensorboard \
    "numpy<2" \
    pillow \
    pyyaml \
    tiktoken

# Copy source tree
COPY src/ ./src/
COPY pyproject.toml ./

# Put src/ on sys.path so `python src/application/main.py` can
# `from framework import ...` and `from application import ...`
ENV PYTHONPATH=/app/src

# Default: 1 epoch of MLP. Overridable via command line.
ENTRYPOINT ["python", "src/application/main.py"]
CMD ["--experiment", "mlp", "--epochs", "1"]
