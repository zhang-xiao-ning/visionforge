FROM python:3.12-slim

# Use Tsinghua mirror to speed up non-torch installs (China network)
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

WORKDIR /app

# CPU torch / torchvision from the official CPU index
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.2.2 torchvision==0.17.2

# Other dependencies via the Tsinghua mirror
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    python-multipart \
    pillow \
    "onnxruntime<1.20" \
    "numpy<2"

# Copy source tree
COPY src/ ./src/

# exports/ is mounted by docker-compose; for standalone runs use -v
RUN mkdir -p /app/exports

ENV PYTHONPATH=/app/src
ENV ONNX_PATH=/app/exports/mlp.onnx

EXPOSE 8000

CMD ["uvicorn", "serving.api:app", "--host", "0.0.0.0", "--port", "8000"]
